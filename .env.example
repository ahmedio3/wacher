# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# OPENCODE_ZEN_API_KEY: Required for OpenCode Zen AI API calls (OpenAI-compatible).
# Get one at https://opencode.ai
OPENCODE_ZEN_API_KEY=MY_OPENCODE_ZEN_API_KEY

# BYNARA_API_KEY: Required for Bynara AI API calls (OpenAI-compatible).
# Get one at https://bynara.id
BYNARA_API_KEY=MY_BYNARA_API_KEY

# AGNES_API_KEY: Required for Agnes AI API calls (OpenAI-compatible).
# Endpoint: https://apihub.agnes-ai.com/v1
AGNES_API_KEY=MY_AGNES_API_KEY

# TMDB API v3 key for movie/TV metadata lookups.
# Get one at https://www.themoviedb.org/settings/api
# TMDB_API_KEY=970be69502451a04b3c38cbd368fda36

# SubDL API key for subtitle downloads.
# Get one at https://subdl.com
# SUBDL_API_KEY=subdl_BLYRvzz54CHwxZVHbNW_eA7iDySnKeFhvc8XYnAXPZ0

# OpenSubtitles API key for subtitle downloads.
# Get one at https://www.opensubtitles.com/
# OPENSUBTITLES_API_KEY=JbFq0O0rQD6DsOCciqPmZIoMVFEPcSpT

# ImgBB API key for profile picture upload.
# Get one at https://api.imgbb.com/
# IMGBB_API_KEY=your_imgbb_api_key_here
